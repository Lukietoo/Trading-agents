# Copy this file to .env and fill in real values.
# .env is gitignored and machine-local — it does not sync between machines,
# so each one needs its own copy. Never commit real keys.

# Alpaca paper trading credentials. Paper host only, never the live one.
ALPACA_API_KEY_ID=your-paper-key-id-here
ALPACA_API_SECRET_KEY=your-paper-secret-here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# Optional — all-time P&L is measured from this. Defaults to 100000.
# PNL_BASELINE=100000

# Fundamentals, news, earnings and insider data. Free tier: 60 req/min.
# Key from https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-key-here

# Macro series (DFF, CPIAUCSL, UNRATE, T10Y2Y). Free.
# Key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your-fred-key-here
